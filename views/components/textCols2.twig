{% set textCols = post.meta('textCols2') %}
{% set center = (center) ? ' text-center' : '' %}
{% if textCols %}
	<section class="section{{ center }} text-cols{% if bgColor %} text-cols-bg{% endif %} container{% if not textCols.title or not textCols.description %} text-cols__full{% endif %}">
		{% if textCols.title %}<h2 class="text-cols__title subtitle">{{ textCols.title }}</h2>{% endif %}
		{% if textCols.description %}<div class="text-cols__description content">{{ textCols.description }}</div>{% endif %}
	</section>
{% endif %}
