{% if cards | length > 0 %}
	<ul class="milestones">
		{% for card in cards %}
			{% set img = get_image(card.image) %}
			{% if card.number or img or card.title %}
				<li>
					<div class="milestones__wrapper">
						{% if card.number or img %}
							<div class="milestones__header">
								{% if img %}
									<div class="milestones__image">
										<img src="{{ img.src|resize(0, 35) }}" alt="{{ img.alt }}" loading="lazy" height="45">
									</div>
								{% endif %}
								{% if card.number %}
									<p class="milestones__number">{{ card.number }}</p>
								{% endif %}
							</div>
						{% endif %}
						{% if card.title %}
							<h2 class="milestones__title">{{ card.title }}</h2>
						{% endif %}
					</div>

					<span class="symbol">+</span>
				</li>
			{% endif %}
		{% endfor %}
	</ul>
{% endif %}
