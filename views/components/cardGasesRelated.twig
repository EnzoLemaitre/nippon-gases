{% set fields = fn('get_field', 'textCols', gas.ID) %}
{% set image = fn('get_field', 'cardGases', gas.ID).image %}
<article class="card-related-gases">
	<a href="{{ fn ('get_permalink', gas.ID)}}">
		<div class="card-related-gases__image">
			{% if image %}
				{% set img = get_image(image) %}
				<img src="{{ img.src|resize(290) }}" alt="{{ gas.post_title }}" loading="lazy" width="290">
			{% else %}
				<img src="{{site.theme.uri}}/assets/img/related-gase.jpg" alt="{{ gas.post_title }}" loading="lazy" width="290">
			{% endif %}
		</div>
		<div class="card-related-gases__text">
			<h3 class="card-related-gases__title">{{ gas.post_title }}</h3>
			<p class="card-related-gases__description">{{ fields.description|striptags|slice(0, 100) ~ '…' }}</p>
			<p class="card-related-gases__read-more">
				<span class="card-related-gases__read-more__inner">
					<span>{{ __('Read more', 'ng') }}</span>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26 26"><path d="M25 13H1.1M13 1.1V25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.1px"/></svg>
				</span>
			</p>
		</div>
	</a>
</article>
