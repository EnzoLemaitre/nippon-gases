	{% set langs = fn('pll_the_languages', { 'raw': 1 }) %}
	<ul class="header__lang-selector__list">
		{% for lang in langs %}
   			<li{{ lang.current_lang ? ' class="active"' }}>
      			<a href="{{ lang.url }}">
					<img src="{{ lang.flag }}" alt="{{ lang.name }}" loading="lazy">
					<span>{{ lang.name }}</span>
				</a>
    		</li>
  		{% endfor %}
	</ul>
</div>
