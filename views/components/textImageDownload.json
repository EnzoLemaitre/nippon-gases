{
	"title": "Image Text Download",
	"location": [
		[
			{
				"param": "page_template",
				"operator": "==",
				"value": "template-compliance.php"
			}
		]
	],
	"fields": [
		{
			"name": "imageTextDownload",
			"type": "group",
			"layout": "row",
			"sub_fields": [
				{
					"label": "Image",
					"name": "image",
					"type": "image",
					"return_format": "array",
					"preview_size": "thumbnail"
				},
				{
					"label": "Image position",
					"name": "imagePosition",
					"type": "select",
					"choices": {
						"left": "Left",
						"right": "Right"
					},
					"default_value": "left"
				},
				{
					"label": "Title",
					"name": "title",
					"type": "text"
				},
				{
					"label": "Subtitle",
					"name": "subtitle",
					"type": "text"
				},
				{
					"label": "Description",
					"name": "decription",
					"type": "textarea",
					"new_lines": "wpautop"
				},
				{
					"label": "Button download",
					"name": "download",
					"type": "group",
					"layout": "row",
					"sub_fields": [
						{
							"label": "Label of the button",
							"name": "label",
							"type": "text"
						},
						{
							"label": "File",
							"name": "file",
							"type": "file"
						}
					]
				}
			]
		}
	]
}
