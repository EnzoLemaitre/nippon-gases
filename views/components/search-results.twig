<style>
  @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&display=swap');

  #search-page {
    font-family: 'Barlow', sans-serif;
    padding: 60px 0;
    background: #fff;
  }

  .search__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .search__header {
    margin-bottom: 40px;
  }

  .search__title {
    font-size: 42px;
    font-weight: 400;
    margin-bottom: 20px;
    color: #1a1a1a;
  }

  .search__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #666;
    text-decoration: none;
    font-size: 16px;
    margin-bottom: 10px;
    transition: color 0.3s;
  }

  .search__back:hover {
    color: #000;
  }

  .search__form {
    margin-bottom: 40px;
    position: relative;
  }

  .search__input {
    width: 100%;
    padding: 18px 140px 18px 24px;
    border: 2px solid #e0e0e0;
    border-radius: 50px;
    font-size: 18px;
    font-family: 'Barlow', sans-serif;
    transition: border-color 0.3s;
  }

  .search__input:focus {
    outline: none;
    border-color: #000;
  }

  .search__submit {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    padding: 12px 32px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 50px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.3s;
  }

  .search__submit:hover {
    background: #333;
  }

  .search__results-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid #e0e0e0;
  }

  .search__results-title {
    font-size: 24px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .search__results-count {
    color: #666;
    font-weight: 400;
  }

  .search__results-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .search__result-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 24px 0;
    border-bottom: 1px solid #e0e0e0;
    gap: 30px;
  }

  .search__result-item:last-child {
    border-bottom: none;
  }

  .search__result-content {
    flex: 1;
  }

  .search__result-meta {
    font-size: 14px;
    color: #999;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .search__result-title {
    font-size: 22px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .search__result-excerpt {
    font-size: 16px;
    color: #666;
    line-height: 1.6;
  }

  .search__result-link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: #fff;
    color: #000;
    border: 2px solid #000;
    border-radius: 50px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    transition: all 0.3s;
    white-space: nowrap;
  }

  .search__result-link:hover {
    background: #000;
    color: #fff;
  }

  .search__result-arrow {
    transition: transform 0.3s;
  }

  .search__result-link:hover .search__result-arrow {
    transform: translateX(4px);
  }

  .search__no-results {
    text-align: center;
    padding: 80px 20px;
    color: #666;
    font-size: 18px;
  }

  .search__pagination {
    margin-top: 50px;
    text-align: center;
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .search__pagination-link {
    display: inline-block;
    padding: 10px 16px;
    border: 1px solid #ddd;
    text-decoration: none;
    color: #333;
    border-radius: 4px;
    font-weight: 500;
    transition: all 0.3s;
  }

  .search__pagination-link:hover {
    background: #f5f5f5;
    border-color: #999;
  }

  .search__pagination-link--active {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  @media (max-width: 968px) {
    .search__title {
      font-size: 32px;
    }

    .search__input {
      padding: 16px 20px;
      font-size: 16px;
    }

    .search__submit {
      position: static;
      transform: none;
      width: 100%;
      margin-top: 12px;
    }

    .search__result-item {
      flex-direction: column;
      gap: 16px;
    }

    .search__result-link {
      align-self: flex-start;
    }
  }
</style>

<div class="search__container">
  <div class="search__header">
    <a href="javascript:history.back()" class="search__back">
      {{ i18n.back_arrow }} Back
    </a>
    <h1 class="search__title">{{ page_title }}</h1>
  </div>

  <form method="get" action="" class="search__form">
    <input 
      type="text" 
      name="s" 
      class="search__input"
      placeholder="{{ i18n.search_placeholder }}" 
      value="{{ search_query }}"
      required
    >
    <button type="submit" class="search__submit">{{ i18n.search_button }}</button>
  </form>

  {% if search_query %}
    <div class="search__results-header">
      <h2 class="search__results-title">
        {{ i18n.results_count }}
        {% if results_count > 0 %}
          <span class="search__results-count">({{ results_count }})</span>
        {% endif %}
      </h2>
    </div>

    {% if results is not empty %}
      <ul class="search__results-list">
        {% for result in results %}
          <li class="search__result-item">
            <div class="search__result-content">
              <div class="search__result-meta">
                {{ result.post_type_label }}
              </div>
              <h3 class="search__result-title">{{ result.title }}</h3>
              <p class="search__result-excerpt">{{ result.excerpt }}</p>
            </div>
            <a href="{{ result.url }}" class="search__result-link">
              {{ i18n.view_page }}
              <span class="search__result-arrow">→</span>
            </a>
          </li>
        {% endfor %}
      </ul>

      {% if pagination.total > 1 %}
        <div class="search__pagination">
          {% for i in 1..pagination.total %}
            <a 
              href="?s={{ search_query }}&paged={{ i }}" 
              class="search__pagination-link {% if i == pagination.current %}search__pagination-link--active{% endif %}"
            >
              {{ i }}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="search__no-results">
        {{ i18n.no_results }}
      </div>
    {% endif %}
  {% endif %}
</div>
