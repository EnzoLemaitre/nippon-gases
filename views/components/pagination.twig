{% if posts.pagination %}
    {% set current = posts.pagination.current %}
    {% set pages = posts.pagination.pages %}
    {% set range = 2 %}

    <nav class="pagination-news container">
        {% if posts.pagination.prev %}
            <a href="{{ posts.pagination.prev.link }}" class="pagination-news__prev" aria-label="{{ __('Previous page', 'ng') }}">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 49.9 96.2" fill="currentColor"><path d="M47 96.2c-.7 0-1.3-.3-1.8-.7L2.6 54.4c-3.4-3.3-3.5-8.8-.2-12.2l.2-.2L45.2 1c.9-1.1 2.6-1.3 3.7-.4s1.3 2.6.4 3.7c-.1.2-.3.3-.5.5l-42.5 41c-1.3 1.3-1.4 3.4 0 4.8l42.5 41.1c1 1 1.1 2.7 0 3.7-.5.5-1.2.8-1.9.8Z"/></svg>
			</a>
        {% endif %}

        {% if pages|first.title != current - range and current > range + 1 %}
            <a href="{{ pages|first.link }}">1</a>
            <span class="dots">…</span>
        {% endif %}

        {% for page in pages %}
            {% if page.title >= current - range and page.title <= current + range %}
				{% if page.current %}
					<span class="pagination-news__link current">{{ page.title }}</span>
				{% else %}
					<a href="{{ page.link }}" class="pagination-news__link">
						{{ page.title }}
					</a>
				{% endif %}
            {% endif %}
        {% endfor %}

        {% if pages|last.title != current + range and current < pages|last.title - range %}
            <span class="dots">…</span>
            <a href="{{ pages|last.link }}">{{ pages|last.title }}</a>
        {% endif %}

        {% if posts.pagination.next %}
            <a href="{{ posts.pagination.next.link }}" class="pagination-news__next" aria-label="{{ __('Next page', 'ng') }}">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 49.9 96.2" fill="currentColor"><path d="M47 96.2c-.7 0-1.3-.3-1.8-.7L2.6 54.4c-3.4-3.3-3.5-8.8-.2-12.2l.2-.2L45.2 1c.9-1.1 2.6-1.3 3.7-.4s1.3 2.6.4 3.7c-.1.2-.3.3-.5.5l-42.5 41c-1.3 1.3-1.4 3.4 0 4.8l42.5 41.1c1 1 1.1 2.7 0 3.7-.5.5-1.2.8-1.9.8Z"/></svg>
			</a>
        {% endif %}
    </nav>
{% endif %}
