<div class="search-filters">
	<div class="search-form">

		<div class="search-group">
			{% if search.input_company %}
				<div class="content">{{ search.input_company }}</div>
			{% endif %}
			<input type="text" id="company-search" class="search-input" placeholder="{{ __('Company name', 'ng') }}">
		</div>

		<div class="search-group">
			{% if search.input_city %}
				<div class="content">{{ search.input_city }}</div>
			{% endif %}
			<input type="text" id="location-search" class="search-input" placeholder="{{ __('City or Postcode', 'ng') }}">
		</div>

		<div class="search-actions">
			{% include 'components/distributor-button-search.twig' with {
                label: __('Find delivery point', 'ng'),
                type: 'button',
                class: 'btn',
                attributes: 'id="search-btn"'
            } %}

			{% include 'components/distributor-button-search.twig' with {
                label: __('Reset results', 'ng'),
                type: 'button',
                class: 'btn btn__light',
                attributes: 'id="reset-btn"'
            } %}
		</div>

	</div>
</div>
