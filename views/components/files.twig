		{% if files.title %}<h2 class="files-compo__title subtitle mb-40">{{ files.title }}</h2>{% endif %}
		<ul>
			{% for file in files.files %}
				<li class="files-compo__item">
					<a href="{{ file.url }}" class="files-compo__link" download>
						<span class="files-compo__name">{{ file.title }}</span>
						<span class="files-compo__icon">
							<svg viewBox="0 0 36 37" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.1243 28.8464C17.1306 28.8526 17.1387 28.8545 17.145 28.8602C17.1993 28.9132 17.263 28.9557 17.3329 28.9854C17.4087 29.017 17.49 29.0332 17.5721 29.033C17.6853 29.0429 17.7978 29.0078 17.8853 28.9353C17.9303 28.9138 17.9724 28.8866 18.0106 28.8545L25.0478 21.8186C25.2924 21.5741 25.2924 21.1775 25.0478 20.9329C24.8032 20.6883 24.4066 20.6883 24.162 20.9329L18.1985 26.8959V0.62636C18.1985 0.280431 17.9181 0 17.5721 0C17.2262 0 16.9458 0.280431 16.9458 0.62636V26.8708L11.2152 21.0138C10.9731 20.7664 10.5763 20.7622 10.3289 21.0044C10.0816 21.2465 10.0774 21.6433 10.3195 21.8907L17.1243 28.8464Z" fill="currentColor"/><path d="M0.626359 36.6624H34.7461C35.092 36.6624 35.3724 36.382 35.3724 36.036V25.9623C35.3724 25.6164 35.092 25.3359 34.7461 25.3359C34.4001 25.3359 34.1197 25.6164 34.1197 25.9623V35.4097H1.25272V25.9623C1.25272 25.6164 0.972289 25.3359 0.62636 25.3359C0.280431 25.3359 0 25.6164 0 25.9623V36.036C0 36.382 0.28043 36.6624 0.626359 36.6624Z" fill="currentColor"/></svg>
						</span>
					</a>
				</li>
			{% endfor %}
		</ul>
	</section>
