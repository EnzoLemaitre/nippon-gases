<div class="category-filters">
	{% if search.filter_cat %}
		<div class="content">{{ search.filter_cat }}</div>
	{% endif %}
	
	<div class="filter-pills">
		{% for category in categories %}
			{% include 'components/distributor-filter-pill.twig' with {
                label: category.name,
                slug: category.slug,
                icon: category.category_icon
            } %}
		{% endfor %}
	</div>
</div>
