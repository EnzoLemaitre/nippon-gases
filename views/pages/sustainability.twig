{% extends 'layout/base.twig' %}

{% block body %}
	<main id="sustainability">
		{% include 'components/heroBanner.twig' %}
		{% include 'components/imageTextBackground.twig' %}
		{% include 'components/imageTextBackgroundWithSquares.twig' %}

		<section class="section our-milestones">
			{% set milestones = post.meta('ourMilestones') %}
			{% if milestones.title or milestones.description %}
				<div class="our-milestones__text">
					<h2 class="subtitle">{{ milestones.title }}</h2>
					<div class="conent">{{ milestones.description }}</div>
				</div>
			{% endif %}

			{% include 'components/milestones.twig' with { cards: milestones.card } %}
		</section>

		{% include 'components/imageText.twig' %}
		{% include 'components/textColsBlue2.twig' %}
	</main>
{% endblock %}
