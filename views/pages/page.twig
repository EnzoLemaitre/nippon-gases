{% extends 'layout/base.twig' %}

{% block body %}
	<main id="page">
		{% set heroBanner = post.meta('herobanner') %}
		{% if heroBanner.image != false or heroBanner.subtitle != '' or heroBanner.link != '' %}
			{% include 'components/heroBanner.twig' %}
		{% else %}
			<div class="container header-page">
				{% include 'components/breadcrumb.twig' %}
				<h1 class="title-page">{{ post.title }}</h1>
			</div>
		{% endif %}

		<div class="content container section">{{ post.content }}</div>

		{% include 'components/contactAlert.twig' %}
	</main>
{% endblock %}
