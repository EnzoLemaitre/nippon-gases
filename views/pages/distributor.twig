{% extends 'layout/base.twig' %}
{% set search = post.meta('search') %}

{% block body %}
	<main id="distributor" class="container">
		<div class="header-page">
			{% include 'components/breadcrumb.twig' %}
		</div>

		<section class="distributor section">
			{% if search.title %}
				<h1 class="page-title">{{ search.title }}</h1>
			{% endif %}

			{% include 'components/distributor-cat-button.twig' %}
			{% include 'components/distributor-search.twig' %}

			<div class="distributor__map">
				<div class="distributor__map__left">
					{% include 'components/distributor-results.twig' %}
				</div>

				<div id="distributor-map"></div>
			</div>


		</section>
	</main>
{% endblock %}


{% block javascripts %} <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAQ8Kreenw5NbFLeJc8gf66IaSn7_dWfyg&callback=initMap" defer></script>
	 <script src="{{site.theme.uri}}/assets/js/map.js" defer></script>
	 <script src="{{site.theme.uri}}/dist/distributor.js" defer></script>
{% endblock %}
