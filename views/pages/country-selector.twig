<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {{ fn('wp_head') }}
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Barlow', sans-serif;
            background: #000;
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .selector {
            max-width: 600px;
            width: 100%;
            text-align: center;
        }

        .selector__logo {
            margin-bottom: 60px;
        }

        .selector__logo img {
            max-width: 200px;
            height: auto;
        }

        .selector__title {
            font-size: 36px;
            font-weight: 400;
            margin-bottom: 16px;
            line-height: 1.2;
        }

        .selector__subtitle {
            font-size: 16px;
            color: #999;
            margin-bottom: 60px;
            line-height: 1.5;
        }

        .selector__form {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .selector__select-wrapper {
            position: relative;
        }

        .selector__select {
            width: 100%;
            padding: 20px 50px 20px 24px;
            background: transparent;
            border: 1px solid #333;
            border-radius: 4px;
            color: #fff;
            font-size: 18px;
            font-family: 'Barlow', sans-serif;
            cursor: pointer;
            appearance: none;
            transition: border-color 0.3s;
        }

        .selector__select:hover:not(:disabled) {
            border-color: #666;
        }

        .selector__select:focus {
            outline: none;
            border-color: #fff;
        }

        .selector__select:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            color: #666;
        }

        .selector__select option {
            background: #000;
            color: #fff;
        }

        .selector__select-arrow {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            color: #fff;
        }

        .selector__error {
            color: #ff6b6b;
            font-size: 14px;
            font-style: italic;
            min-height: 20px;
            margin-top: -8px;
        }

        .selector__button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 18px 48px;
            background: #fff;
            color: #000;
            border: none;
            border-radius: 50px;
            font-size: 18px;
            font-weight: 500;
            font-family: 'Barlow', sans-serif;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
            position: relative;
        }

        .selector__button:hover {
            background: #e0e0e0;
        }

        .selector__button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .selector__button-arrow {
            width: 24px;
            height: 24px;
            border: 2px solid #000;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        @media (max-width: 768px) {
            .selector__title {
                font-size: 28px;
            }

            .selector__subtitle {
                font-size: 14px;
            }

            .selector__select {
                font-size: 16px;
                padding: 16px 40px 16px 20px;
            }

            .selector__button {
                width: 100%;
                justify-content: center;
            }
        }

        .selector--loading {
            opacity: 0.6;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <div class="selector" id="countrySelector">
        {% if logo %}
        <div class="selector__logo">
            <img src="{{ logo.url }}" alt="{{ logo.alt ?: 'Nippon Gases' }}">
        </div>
        {% endif %}

        <h1 class="selector__title">{{ title }}</h1>
        <p class="selector__subtitle">{{ subtitle }}</p>

        <form class="selector__form" id="selectorForm">
            <div class="selector__select-wrapper">
                <select class="selector__select" id="countrySelect" name="country" required>
                    <option value="">{{ i18n.choose_country }}</option>
                    {% for country in countries %}
                        <option value="{{ country.code }}">{{ country.name }}</option>
                    {% endfor %}
                </select>
                <span class="selector__select-arrow">▼</span>
            </div>

            <div class="selector__select-wrapper">
                <select class="selector__select" id="languageSelect" name="language" required disabled>
                    <option value="">{{ i18n.choose_language }}</option>
                </select>
                <span class="selector__select-arrow">▼</span>
            </div>

            <div class="selector__error" id="errorMessage"></div>

            <button type="button" class="selector__button" id="submitButton">
                {{ i18n.select_button }}
                <span class="selector__button-arrow">→</span>
            </button>
        </form>
    </div>

    <script>
        // Configuration complète des pays et leurs sites
        const countriesConfig = {{ countries_config|raw }};
        
        const countrySelect = document.getElementById('countrySelect');
        const languageSelect = document.getElementById('languageSelect');
        const errorMessage = document.getElementById('errorMessage');
        const selectorForm = document.getElementById('selectorForm');
        const selector = document.getElementById('countrySelector');

        // Détection automatique du navigateur
        function detectAndRedirect() {
            const browserLang = navigator.language || navigator.userLanguage;
            const langCode = browserLang.split('-')[0].toLowerCase();
            const countryCode = browserLang.split('-')[1]?.toUpperCase();
            
            console.log('Browser detected:', browserLang, 'Lang:', langCode, 'Country:', countryCode);

            // Essayer de matcher pays + langue
            if (countryCode && countriesConfig[countryCode]) {
                const country = countriesConfig[countryCode];
                if (country.languages[langCode]) {
                    console.log('Exact match found, redirecting to:', country.url);
                    window.location.href = country.url;
                    return true;
                }
            }

            // Essayer de trouver un pays qui a cette langue
            for (const [code, config] of Object.entries(countriesConfig)) {
                if (config.languages[langCode]) {
                    console.log('Language match found, redirecting to:', config.url);
                    window.location.href = config.url;
                    return true;
                }
            }

            return false;
        }

        // Activer la détection automatique
        if (detectAndRedirect()) {
            selector.classList.add('selector--loading');
        }

        // Gestion du changement de pays
        countrySelect.addEventListener('change', function() {
            const selectedCountry = this.value;
            
            // Réinitialiser
            languageSelect.innerHTML = '<option value="">{{ i18n.choose_language }}</option>';
            errorMessage.textContent = '';

            if (selectedCountry && countriesConfig[selectedCountry]) {
                const country = countriesConfig[selectedCountry];
                languageSelect.disabled = false;
                
                // Remplir avec les langues disponibles pour ce pays
                Object.entries(country.languages).forEach(([code, name]) => {
                    const option = document.createElement('option');
                    option.value = code;
                    option.textContent = name;
                    languageSelect.appendChild(option);
                });
            } else {
                languageSelect.disabled = true;
            }
        });

        // Gestion du clic sur le bouton
        submitButton.addEventListener('click', function(e) {
            e.preventDefault();
            
            const country = countrySelect.value;
            const language = languageSelect.value;

            if (!country || !language) {
                errorMessage.textContent = '{{ i18n.error_message }}';
                return;
            }

            const countryConfig = countriesConfig[country];
            
            if (countryConfig) {
                selector.classList.add('selector--loading');
                
                // Si une seule langue, rediriger vers l'URL du pays
                if (Object.keys(countryConfig.languages).length === 1) {
                    window.location.href = countryConfig.url;
                } else {
                    // Si multilingue, vérifier si c'est la langue principale
                    const firstLang = Object.keys(countryConfig.languages)[0];
                    if (language === firstLang) {
                        window.location.href = countryConfig.url;
                    } else {
                        window.location.href = countryConfig.url + language + '/';
                    }
                }
            } else {
                errorMessage.textContent = 'Country not found';
            }
        });

        // Effacer le message d'erreur
        languageSelect.addEventListener('change', function() {
            errorMessage.textContent = '';
        });
    </script>

    {{ fn('wp_footer') }}
</body>
</html>
