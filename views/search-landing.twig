{% extends "layout/base.twig" %}

{% block body %}
<style>
  .search-landing {
    font-family: 'Barlow', sans-serif;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 40px;
    background: #fff;
  }

  .search-landing__container {
    max-width: 800px;
    width: 100%;
    text-align: center;
  }

  .search-landing__title {
    font-size: 48px;
    font-weight: 400;
    margin-bottom: 40px;
    color: #1a1a1a;
  }

  .search-landing__form {
    position: relative;
    max-width: 700px;
    margin: 0 auto;
    background: #f8f8f8;
    padding: 20px;
    border-radius: 8px;
  }

  .search-landing__input {
    width: 100%;
    padding: 16px 50px 16px 20px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 18px;
    font-family: 'Barlow', sans-serif;
    background: #fff;
    transition: border-color 0.3s;
  }

  .search-landing__input:focus {
    outline: none;
    border-color: #999;
  }

  .search-landing__submit {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .search-landing__submit svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 768px) {
    .search-landing__title {
      font-size: 36px;
    }

    .search-landing__input {
      padding: 18px 24px;
      font-size: 18px;
    }

    .search-landing__submit {
      position: static;
      transform: none;
      width: 100%;
      margin-top: 16px;
    }
  }
</style>

<div class="search-landing">
  <div class="search-landing__container">
    <h1 class="search-landing__title">{{ page_title }}</h1>
    
    <form method="get" action="{{ site.url }}" class="search-landing__form" role="search">
      <input 
        type="text" 
        name="s" 
        class="search-landing__input"
        placeholder="{{ i18n.search_placeholder }}" 
        required
        autofocus
      >
      <button type="submit" class="search-landing__submit" aria-label="{{ i18n.search_button }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
    </form>
  </div>
</div>
{% endblock %}
