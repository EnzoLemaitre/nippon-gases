{% extends "layout/base.twig" %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&display=swap');

  .search-page {
    font-family: 'Barlow', sans-serif;
    padding: 60px 0 100px;
    background: #fff;
  }

  .search-page__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .search-page__header {
    margin-bottom: 40px;
  }

  .search-page__title {
    font-size: 42px;
    font-weight: 400;
    margin-bottom: 20px;
    color: #1a1a1a;
  }

  .search-page__subtitle {
    font-size: 18px;
    color: #666;
    margin-bottom: 30px;
  }

  .search-page__form {
    margin-bottom: 50px;
    position: relative;
    max-width: 100%;
    background: #f8f8f8;
    padding: 20px;
    border-radius: 8px;
  }

  .search-page__input {
    width: 100%;
    padding: 16px 50px 16px 20px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 16px;
    font-family: 'Barlow', sans-serif;
    background: #fff;
    transition: border-color 0.3s;
  }

  .search-page__input:focus {
    outline: none;
    border-color: #999;
  }

  .search-page__submit {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .search-page__submit svg {
    width: 20px;
    height: 20px;
  }

  .search-page__results-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid #e0e0e0;
  }

  .search-page__results-title {
    font-size: 24px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .search-page__results-count {
    color: #666;
    font-weight: 400;
  }

  .search-page__results-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .search-page__result-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 30px 0;
    border-bottom: 1px solid #e0e0e0;
    gap: 30px;
  }

  .search-page__result-item:last-child {
    border-bottom: none;
  }

  .search-page__result-content {
    flex: 1;
  }

  .search-page__result-meta {
    font-size: 13px;
    color: #999;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .search-page__result-title {
    font-size: 24px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .search-page__result-title a {
    color: #1a1a1a;
    text-decoration: none;
    transition: color 0.3s;
  }

  .search-page__result-title a:hover {
    color: #666;
  }

  .search-page__result-excerpt {
    font-size: 16px;
    color: #666;
    line-height: 1.6;
  }

  .search-page__result-link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: #fff;
    color: #000;
    border: 1px solid #ddd;
    border-radius: 50%;
    text-decoration: none;
    transition: all 0.3s;
  }

  .search-page__result-link:hover {
    background: #f0f0f0;
    border-color: #999;
  }

  .search-page__result-arrow {
    transition: transform 0.3s;
    font-size: 20px;
  }

  .search-page__result-link:hover .search-page__result-arrow {
    transform: translateX(2px);
  }

  .search-page__no-results {
    text-align: center;
    padding: 80px 20px;
    color: #666;
    font-size: 18px;
  }

  .search-page__pagination {
    margin-top: 60px;
    text-align: center;
  }

  @media (max-width: 968px) {
    .search-page__title {
      font-size: 32px;
    }

    .search-page__input {
      padding: 16px 20px;
      font-size: 16px;
    }

    .search-page__submit {
      position: static;
      transform: none;
      width: 100%;
      margin-top: 12px;
    }

    .search-page__result-item {
      flex-direction: column;
      gap: 16px;
    }

    .search-page__result-link {
      align-self: flex-start;
    }
  }
</style>

<div class="search-page">
  <div class="search-page__container">
    
    <div class="search-page__header">
      <h1 class="search-page__title">{{ page_title }}</h1>
      {% if search_query %}
        <p class="search-page__subtitle">
          {{ i18n.results_for }} "<strong>{{ search_query }}</strong>"
          {% if found_posts > 0 %}
            — {{ found_posts }} {{ i18n.found_results }}
          {% endif %}
        </p>
      {% endif %}
    </div>

    <form method="get" action="{{ site.url }}" class="search-page__form" role="search">
      <input 
        type="text" 
        name="s" 
        class="search-page__input"
        placeholder="{{ i18n.search_placeholder }}" 
        value="{{ search_query }}"
        required
      >
      <button type="submit" class="search-page__submit" aria-label="{{ i18n.search_button }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
    </form>

    {% if search_query %}
      {% if posts %}
        <ul class="search-page__results-list">
          {% for post in posts %}
            <li class="search-page__result-item">
              <div class="search-page__result-content">
                <div class="search-page__result-meta">
                  {{ post.type.labels.singular_name }}
                </div>
                <h2 class="search-page__result-title">
                  <a href="{{ post.link }}">{{ post.title }}</a>
                </h2>
                <p class="search-page__result-excerpt">
                  {{ post.preview.length(100) }}
                </p>
              </div>
              <a href="{{ post.link }}" class="search-page__result-link" aria-label="{{ i18n.view_page }}">
                <span class="search-page__result-arrow">→</span>
              </a>
            </li>
          {% endfor %}
        </ul>

        {% if pagination and pagination.pages %}
          <div class="search-page__pagination">
            {% if pagination.prev %}
              <a href="{{ pagination.prev.link }}" class="search-page__pagination-link">← Précédent</a>
            {% endif %}
            
            {% for page in pagination.pages %}
              <a href="{{ page.link }}" class="search-page__pagination-link {% if page.current %}search-page__pagination-link--active{% endif %}">
                {{ page.title }}
              </a>
            {% endfor %}
            
            {% if pagination.next %}
              <a href="{{ pagination.next.link }}" class="search-page__pagination-link">Suivant →</a>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <div class="search-page__no-results">
          {{ i18n.no_results }}
        </div>
      {% endif %}
    {% endif %}

  </div>
</div>
{% endblock %}
